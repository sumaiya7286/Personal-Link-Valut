# Copy this file to .env.local and fill in your Supabase project values.
# Supabase Dashboard → Project Settings → API.
# Leave these empty to run Stash in demo mode (links saved in the browser only).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to true after enabling the Google provider in Supabase → Authentication → Providers.
NEXT_PUBLIC_AUTH_GOOGLE=false
